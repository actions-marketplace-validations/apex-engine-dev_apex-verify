+/** The names of the tests in a checks file (node:test / jest / vitest, pytest, Go, Rust). */
+export function testNames(code: string): string[] {
+  const out: string[] = [];
+  for (const m of code.matchAll(/(?:^|[^\w.])(?:test|it|t\.test)\s*\(\s*(["'`])((?:\\.|(?!\1).)*)\1/gm)) out.push(m[2]);
+  for (const m of code.matchAll(/^\s*(?:async\s+)?def\s+(test_\w+)/gm)) out.push(m[1]);
+  for (const m of code.matchAll(/^func\s+(Test\w+)\s*\(/gm)) out.push(m[1]);
+  for (const m of code.matchAll(/#\[test\]\s*(?:#\[[^\]]*\]\s*)*(?:pub\s+)?fn\s+(\w+)/g)) out.push(m[1]);
+  return out;
+}
+
+/** A pruned checks file is accepted only when it removes tests and does nothing else: at least one test left, fewer than before, every one of them a test the first file had. */
+export function prunedOk(before: string, after: string): boolean {
+  const a = testNames(before), b = testNames(after);
+  if (!b.length || b.length >= a.length) return false;
+  const left = [...a];
+  for (const name of b) { const i = left.indexOf(name); if (i < 0) return false; left.splice(i, 1); }
+  return true;
+}
+
+export function prunePrompt(task: string, code: string, lang: string): string {
+  return `<task>\n${task}\n</task>\n\nSomeone wrote this test file from the task, before any change was made:\n\n\`\`\`${lang}\n${code}\`\`\`\n\n` +
+    "Review it against the task. Do not solve the task and do not look for more to test. Remove every test whose expected result is not decided by the task's own words or examples, or (for a test of behaviour the task leaves alone) by how the code above behaves today: a rule the task does not state, a stricter reading than its words require, a guessed exact value or message, a choice a standard leaves to the implementer. " +
+    "Keep every other test exactly as it is: do not add, rename, rewrite or weaken a test, and keep the imports and helpers the remaining tests use. When every test is decided by the task, return the file unchanged. Answer with the whole file in one code block.";
+}
