+
+test("a pruned checks file is accepted only when it removes tests and adds or renames none", async () => {
+  const { prunedOk, testNames } = await import("./proof-gate.js");
+  const file = 'import { test } from "node:test";\ntest("a: stated", () => {});\ntest(\'b\', async () => {});\nit(`c`, () => {});\n';
+  assert.deepEqual(testNames(file), ["a: stated", "b", "c"]);
+  assert.deepEqual(testNames("def test_one():\n    pass\n\nasync def test_two():\n    pass\n"), ["test_one", "test_two"]);
+  assert.deepEqual(testNames("func TestAdd(t *testing.T) {}\n"), ["TestAdd"]);
+  assert.deepEqual(testNames("#[test]\nfn adds() {}\n"), ["adds"]);
+  assert.equal(prunedOk(file, 'import { test } from "node:test";\ntest("a: stated", () => {});\n'), true);
+  assert.equal(prunedOk(file, file), false, "nothing removed");
+  assert.equal(prunedOk(file, 'import { test } from "node:test";\n'), false, "no test left");
+  assert.equal(prunedOk(file, 'test("a: stated", () => {});\ntest("new one", () => {});\n'), false, "a test the first file did not have");
+  assert.equal(prunedOk(file, 'test("b", () => {});\ntest("b", () => {});\n'), false, "the same test twice");
+});
