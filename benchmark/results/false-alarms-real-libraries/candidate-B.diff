+
+/** Text compared loosely: case, quote marks, backslashes and runs of spaces do not matter. */
+const loose = (s: string): string => s.toLowerCase().replace(/[\s"'`\u2018\u2019\u201c\u201d\\]+/g, " ").trim();
+
+/**
+ * The second look, with proof: the arbiter lists each failing check as STATED (with the request's own words that
+ * state the behaviour) or UNSTATED. A failing check blocks only when its quote really is in the request, so "the
+ * change is at fault" needs a sentence of the request to stand on; a quote the arbiter made up counts as none.
+ * "code": at least one failing check is STATED with a quote found in the request. "test": checks were listed and
+ * none is. No list at all: the plain TEST / CODE reading.
+ */
+export function tracedVerdict(text: string, request: string): { verdict: "test" | "code" | "unknown"; reason: string } {
+  const clean = text.replace(/<think>[\s\S]*?<\/think>/g, "").trim();
+  const req = loose(request);
+  let listed = 0, firstWhy = "";
+  for (const line of clean.split("\n")) {
+    const m = /^\W*(STATED|UNSTATED)\s*\|\s*([^|]*)\|\s*(.*)$/.exec(line.trim());
+    if (!m) continue;
+    listed++;
+    const rest = m[3].trim();
+    if (m[1] === "STATED") {
+      const quote = loose(rest);
+      if (quote.split(" ").length >= 3 && req.includes(quote)) return { verdict: "code", reason: `${m[2].trim()}: the request says "${rest.replace(/^["'`]|["'`]$/g, "").slice(0, 200)}"`.slice(0, 300) };
+      firstWhy ||= `${m[2].trim()}: the words quoted for it are not in the request`;
+    } else firstWhy ||= `${m[2].trim()}: ${rest}`;
+  }
+  if (listed) return { verdict: "test", reason: firstWhy.slice(0, 300) };
+  const last = clean.split("\n").map((l) => l.trim()).filter(Boolean).pop() ?? "";
+  return readVerdict(/^\W*(TEST|CODE)\b/.test(last) ? last : clean);
 }
 
