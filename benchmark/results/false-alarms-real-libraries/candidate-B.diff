+  assert.equal(tracedVerdict('STATED | rejects a comma | "values must never contain a comma"\nCODE', request).verdict, "test", "a quote that is not in the request counts as none");
+  assert.equal(tracedVerdict('STATED | x | "the RFC"\nCODE', request).verdict, "test", "two words are not a statement");
+  assert.equal(tracedVerdict("UNSTATED | a | expects a value the request does not fix\nUNSTATED | b | wrong input\nTEST", request).verdict, "test");
+  assert.equal(tracedVerdict("CODE\nthe change misses the rule", request).verdict, "code", "no list: the plain reading");
+  assert.equal(tracedVerdict("TEST", request).verdict, "test");
