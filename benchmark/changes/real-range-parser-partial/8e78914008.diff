diff -ruN a/test/range-parser.js b/test/range-parser.js
--- a/test/range-parser.js	2026-11-23 09:26:38
+++ b/test/range-parser.js	2026-11-23 09:26:38
@@ -81,4 +81,24 @@
     assert.strictEqual(range.length, 1)
