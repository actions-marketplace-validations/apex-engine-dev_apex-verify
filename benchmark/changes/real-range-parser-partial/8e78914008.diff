   })
+
+  // New tests for the fix
+  it('should return only valid ranges when some are invalid', function(){
+    // For a 200-byte resource:
+    // 0-49 is valid
+    // 500-599 is invalid (start > size)
+    // 100-149 is valid
+    var range = parse(200, 'bytes=0-49,500-599,100-149')
+    assert.strictEqual(range.type, 'bytes')
+    assert.strictEqual(range.length, 2)
+    assert.deepEqual(range[0], { start: 0, end: 49 })
+    assert.deepEqual(range[1], { start: 100, end: 149 })
+  })
+
+  it('should return -1 when all ranges are invalid in a multiple range request', function(){
+    // For a 200-byte resource:
+    // 500-599 is invalid (start > size)
+    // 600-699 is invalid (start > size)
+    assert.strictEqual(parse(200, 'bytes=500-599,600-699'), -1)
+  })
