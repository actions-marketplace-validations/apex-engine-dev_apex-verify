diff -ruN a/test/range-parser.js b/test/range-parser.js
--- a/test/range-parser.js	2026-11-23 09:26:38
+++ b/test/range-parser.js	2026-11-23 09:26:38
@@ -81,4 +81,26 @@
     assert.strictEqual(range.length, 1)
     assert.deepEqual(range[0], { start: 0, end: 5 })
   })
+
+  it('should return only valid ranges from multiple, discarding invalid ones', function(){
+    var range = parse(200, 'bytes=0-499,1000-,500-999')
+    assert.strictEqual(range.type, 'bytes')
+    assert.strictEqual(range.length, 1)
+    assert.deepEqual(range[0], { start: 0, end: 199 })
+  })
+
+  it('should return -1 when all ranges are invalid in a multiple range header', function(){
+    assert.strictEqual(parse(200, 'bytes=200-250,500-600'), -1)
+  })
+
+  it('should return -1 for ranges that start beyond the resource size', function(){
+    assert.strictEqual(parse(200, 'bytes=200-200'), -1)
+    assert.strictEqual(parse(200, 'bytes=200-'), -1)
+  })
+
+  it('should return -1 for 0-byte resource', function(){
+    assert.strictEqual(parse(0, 'bytes=0-0'), -1)
+    assert.strictEqual(parse(0, 'bytes=0-'), -1)
+    assert.strictEqual(parse(0, 'bytes=-1'), -1)
+  })
 })
