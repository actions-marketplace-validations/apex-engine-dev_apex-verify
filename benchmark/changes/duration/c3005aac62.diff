+  let seconds = 0;
+  const parts = str.split(/\s+/);
+  for (const part of parts) {
+    const m = /^(\d+)([smhd])$/.exec(part);
+    if (!m) throw new Error("bad duration part: " + part);
+    const value = Number(m[1]);
