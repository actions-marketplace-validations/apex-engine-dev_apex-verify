diff -ruN -x node_modules -x .DS_Store -x .git a/src/duration.js b/src/duration.js
--- a/src/duration.js	2026-11-19 21:42:44
+++ b/src/duration.js	2026-11-20 14:13:54
@@ -1,5 +1,18 @@
+const UNITS = {
+  s: 1,
+  m: 60,
+  h: 3600,
+  d: 86400,
+};
+
 export function parseDuration(str) {
-  const m = /^(\d+)([sm])$/.exec(str);
-  if (!m) throw new Error("bad duration: " + str);
-  return Number(m[1]) * (m[2] === "m" ? 60 : 1);
+  if (typeof str !== "string" || !/^\s*(?:\d+[dhms]\s*)+$/.test(str)) {
+    throw new Error("bad duration: " + str);
+  }
+
+  let total = 0;
+  for (const match of str.matchAll(/(\d+)([dhms])/g)) {
+    total += Number(match[1]) * UNITS[match[2]];
+  }
+  return total;
 }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-20 14:14:05
@@ -1,8 +1,65 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
 import { parseDuration } from "../src/duration.js";
+
 test("existing", () => {
   assert.equal(parseDuration("90s"), 90);
   assert.equal(parseDuration("5m"), 300);
 });
-test("hours", () => assert.equal(parseDuration("1h"), 3600));
+
+test("hours", () => {
+  assert.equal(parseDuration("1h"), 3600);
+});
+
+test("days", () => {
+  assert.equal(parseDuration("1d"), 86400);
+  assert.equal(parseDuration("2d"), 172800);
+});
+
+test("combinations without spaces", () => {
+  assert.equal(parseDuration("1h30m"), 5400);
+  assert.equal(parseDuration("1d2h3m4s"), 86400 + 7200 + 180 + 4);
+});
+
+test("combinations with spaces", () => {
+  assert.equal(parseDuration("2d 4h"), 187200);
+  assert.equal(parseDuration("1d  2h   30m  15s"), 86400 + 7200 + 1800 + 15);
+  assert.equal(parseDuration("  1h 30m  "), 5400);
+});
+
+test("zero durations", () => {
+  assert.equal(parseDuration("0s"), 0);
+  assert.equal(parseDuration("0m"), 0);
+  assert.equal(parseDuration("0h"), 0);
+  assert.equal(parseDuration("0d"), 0);
+});
+
+test("garbage inputs throw Error", () => {
+  const invalidInputs = [
+    "",
+    "   ",
+    "abc",
+    "10",
+    "10x",
+    "5w",
+    "-5s",
+    "1.5h",
+    "1h 30",
+    "1h30",
+    "1h -30m",
+    "1h 30m garbage",
+    "garbage 1h",
+    null,
+    undefined,
+    123,
+    {},
+  ];
+
+  for (const input of invalidInputs) {
+    assert.throws(
+      () => parseDuration(input),
+      Error,
+      `Expected parseDuration(${JSON.stringify(input)}) to throw`
+    );
+  }
+});
