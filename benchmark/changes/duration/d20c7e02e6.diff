+}
diff -ruN -x node_modules -x .DS_Store -x .git a/src/duration.js b/src/duration.js
--- a/src/duration.js	2026-11-19 21:42:44
+++ b/src/duration.js	2026-11-19 21:53:24
@@ -1,5 +1,15 @@
 export function parseDuration(str) {
-  const m = /^(\d+)([sm])$/.exec(str);
-  if (!m) throw new Error("bad duration: " + str);
-  return Number(m[1]) * (m[2] === "m" ? 60 : 1);
+  if (typeof str !== "string" || !/^(?:\s*\d+\s*[smhd])+\s*$/.test(str)) {
+    throw new Error("bad duration: " + str);
+  }
+  let total = 0;
+  for (const m of str.matchAll(/(\d+)\s*([smhd])/g)) {
+    const val = Number(m[1]);
+    const unit = m[2];
+    if (unit === "s") total += val;
+    else if (unit === "m") total += val * 60;
+    else if (unit === "h") total += val * 3600;
+    else if (unit === "d") total += val * 86400;
+  }
+  return total;
 }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-19 21:53:29
@@ -6,3 +6,14 @@
   assert.equal(parseDuration("5m"), 300);
 });
 test("hours", () => assert.equal(parseDuration("1h"), 3600));
+test("days", () => assert.equal(parseDuration("2d"), 2 * 86400));
+test("combinations", () => {
+  assert.equal(parseDuration("1h30m"), 3600 + 30 * 60);
+  assert.equal(parseDuration("2d 4h"), 2 * 86400 + 4 * 3600);
+  assert.equal(parseDuration("1d 2h 3m 4s"), 86400 + 2 * 3600 + 3 * 60 + 4);
+});
+test("garbage throws error", () => {
+  assert.throws(() => parseDuration("garbage"), /bad duration/);
+  assert.throws(() => parseDuration("1d 2x"), /bad duration/);
+  assert.throws(() => parseDuration(""), /bad duration/);
+});
