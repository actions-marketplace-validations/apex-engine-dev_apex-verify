   assert.equal(parseDuration("5m"), 300);
 });
 test("hours", () => assert.equal(parseDuration("1h"), 3600));
+
+test("combinations", () => {
+  assert.equal(parseDuration("1h30m"), 5400);
+  assert.equal(parseDuration("2d 4h"), 187200);
+  assert.equal(parseDuration("2d 4h 30m 10s"), 189010);
+});
+
+test("garbage inputs", () => {
+  assert.throws(() => parseDuration("1h30x"), /bad duration/);
+  assert.throws(() => parseDuration("garbage"), /bad duration/);
+  assert.throws(() => parseDuration(""), /bad duration/);
+  assert.throws(() => parseDuration(null), /bad duration/);
+});
