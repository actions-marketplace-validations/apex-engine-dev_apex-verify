diff -ruN a/index.js b/index.js
--- a/index.js	2026-11-23 09:26:37
+++ b/index.js	2026-11-23 09:26:37
@@ -70,9 +70,17 @@
   // if-modified-since
   if (modifiedSince) {
     var lastModified = resHeaders['last-modified']
-    var modifiedStale = !lastModified || Date.parse(lastModified) > Date.parse(modifiedSince)
+    var dateModifiedSince = Date.parse(modifiedSince)
+    var dateLastModified = Date.parse(lastModified)
 
-    if (modifiedStale) {
+    // An unparseable date should never make a response count as fresh.
+    // If either date is invalid, it's stale.
+    if (isNaN(dateModifiedSince) || isNaN(dateLastModified)) {
+      return false
+    }
+
+    // If the response was modified since the request date, it's stale.
+    if (dateLastModified > dateModifiedSince) {
       return false
     }
   }
