diff -ruN a/index.js b/index.js
--- a/index.js	2026-11-23 09:26:37
+++ b/index.js	2026-11-23 09:26:37
@@ -70,9 +70,20 @@
   // if-modified-since
   if (modifiedSince) {
     var lastModified = resHeaders['last-modified']
-    var modifiedStale = !lastModified || Date.parse(lastModified) > Date.parse(modifiedSince)
+    var parsedModifiedSince = Date.parse(modifiedSince)
+    var parsedLastModified = Date.parse(lastModified)
 
-    if (modifiedStale) {
+    // A response is considered stale if:
+    // 1. The If-Modified-Since date is unparseable.
+    // 2. The Last-Modified date is unparseable or missing.
+    // (Date.parse(undefined) and Date.parse('invalid') both return NaN)
+    if (isNaN(parsedModifiedSince) || isNaN(parsedLastModified)) {
+      return false
+    }
+
+    // A response is considered stale if Last-Modified is after If-Modified-Since.
+    // This is the original logic for valid dates.
+    if (parsedLastModified > parsedModifiedSince) {
       return false
     }
   }
