diff -ruN -x node_modules -x .DS_Store -x .git a/test/extra.test.js b/test/extra.test.js
--- a/test/extra.test.js	1970-01-01 02:00:00
+++ b/test/extra.test.js	2026-11-21 10:20:30
@@ -0,0 +1,18 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { TodoList } from "../src/todos.js";
+
+test("clash and done state", () => {
+  const l = new TodoList(); 
+  l.add("a"); 
+  const itemB = l.add("b"); 
+  l.complete(itemB.id);
+  
+  const r = TodoList.fromJSON(l.toJSON());
+  const itemC = r.add("c");
+  
+  assert.notEqual(itemC.id, itemB.id);
+  assert.equal(r.pending().length, 2);
+  assert.equal(r.pending()[0].text, "a");
+  assert.equal(r.pending()[1].text, "c");
+});
