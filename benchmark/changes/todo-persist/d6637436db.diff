diff -ruN -x node_modules -x .DS_Store -x .git a/src/todos.js b/src/todos.js
--- a/src/todos.js	2026-11-19 21:42:44
+++ b/src/todos.js	2026-11-21 10:28:33
@@ -19,4 +19,19 @@
   pending() {
     return this.items.filter((i) => !i.done);
   }
+  toJSON() {
+    return {
+      items: this.items.map((item) => ({ ...item })),
+      nextId: this.nextId,
+    };
+  }
+  static fromJSON(obj) {
+    const data = typeof obj === "string" ? JSON.parse(obj) : obj;
+    const list = new TodoList();
+    if (!data) return list;
+    list.items = (data.items || []).map((item) => ({ ...item }));
+    const maxId = list.items.reduce((max, item) => Math.max(max, item.id ?? 0), 0);
+    list.nextId = typeof data.nextId === "number" ? Math.max(data.nextId, maxId + 1) : maxId + 1;
+    return list;
+  }
 }
