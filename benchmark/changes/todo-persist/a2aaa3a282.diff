diff -ruN -x node_modules -x .DS_Store -x .git a/src/todos.js b/src/todos.js
--- a/src/todos.js	2026-11-19 21:42:44
+++ b/src/todos.js	2026-11-21 10:26:50
@@ -19,4 +19,37 @@
   pending() {
     return this.items.filter((i) => !i.done);
   }
+  toJSON() {
+    return {
+      items: this.items.map((item) => ({ ...item })),
+    };
+  }
+  static fromJSON(obj) {
+    const list = new TodoList();
+    if (!obj) return list;
+    if (typeof obj === "string") {
+      try {
+        obj = JSON.parse(obj);
+      } catch {
+        return list;
+      }
+    }
+    const rawItems = Array.isArray(obj)
+      ? obj
+      : Array.isArray(obj.items)
+      ? obj.items
+      : [];
+    list.items = rawItems.map((item) => ({
+      ...item,
+      done: Boolean(item.done),
+    }));
+    const maxId = list.items.reduce(
+      (max, item) =>
+        typeof item.id === "number" && item.id > max ? item.id : max,
+      0
+    );
+    const nextId = typeof obj.nextId === "number" ? obj.nextId : 1;
+    list.nextId = Math.max(nextId, maxId + 1);
+    return list;
+  }
 }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-21 10:28:02
@@ -6,3 +6,66 @@
   const r = TodoList.fromJSON(l.toJSON());
   assert.equal(r.pending().length, 1);
 });
+
+test("toJSON returns a plain object snapshot", () => {
+  const l = new TodoList();
+  l.add("first");
+  l.complete(1);
+  const snap = l.toJSON();
+  assert.equal(typeof snap, "object");
+  assert.equal(Array.isArray(snap), false);
+  assert.equal(Object.getPrototypeOf(snap), Object.prototype);
+  assert.deepEqual(snap, {
+    items: [{ id: 1, text: "first", done: true }],
+  });
+
+  // Mutating the snapshot does not mutate the original list
+  snap.items[0].done = false;
+  assert.equal(l.items[0].done, true);
+});
+
+test("new todos on restored list do not clash with existing ids", () => {
+  const l = new TodoList();
+  l.add("a"); // id 1
+  l.add("b"); // id 2
+  l.add("c"); // id 3
+  l.remove(2); // items remaining: id 1, id 3
+
+  const r = TodoList.fromJSON(l.toJSON());
+  const d = r.add("d");
+  assert(![1, 3].includes(d.id), `new id ${d.id} must not clash with existing ids 1 or 3`);
+  assert.equal(d.id, 4);
+
+  const existingIds = r.items.map((it) => it.id);
+  const uniqueIds = new Set(existingIds);
+  assert.equal(uniqueIds.size, existingIds.length);
+});
+
+test("done items stay done after restore", () => {
+  const l = new TodoList();
+  l.add("task 1");
+  l.add("task 2");
+  l.add("task 3");
+  l.complete(1);
+  l.complete(3);
+
+  const r = TodoList.fromJSON(l.toJSON());
+  assert.equal(r.items.find((it) => it.id === 1)?.done, true);
+  assert.equal(r.items.find((it) => it.id === 2)?.done, false);
+  assert.equal(r.items.find((it) => it.id === 3)?.done, true);
+  assert.equal(r.pending().length, 1);
+  assert.equal(r.pending()[0].id, 2);
+});
+
+test("restored list operations work correctly", () => {
+  const l = new TodoList();
+  l.add("initial");
+  const r = TodoList.fromJSON(l.toJSON());
+
+  const added = r.add("next");
+  r.complete(added.id);
+  assert.equal(r.items.find((it) => it.id === added.id)?.done, true);
+  r.remove(1);
+  assert.equal(r.items.length, 1);
+  assert.equal(r.items[0].id, added.id);
+});
