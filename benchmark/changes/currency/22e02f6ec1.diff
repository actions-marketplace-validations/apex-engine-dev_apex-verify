diff -ruN -x node_modules -x .DS_Store -x .git a/src/money.js b/src/money.js
--- a/src/money.js	2026-11-19 21:42:44
+++ b/src/money.js	2026-11-19 21:47:21
@@ -1 +1,28 @@
 export const toCents = (dollars) => Math.round(dollars * 100);
+
+export const formatMoney = (cents, currency) => {
+  if (!Number.isInteger(cents)) {
+    throw new Error("cents must be an integer");
+  }
+  let symbol;
+  if (currency === "USD") {
+    symbol = "$";
+  } else if (currency === "EUR") {
+    symbol = "€";
+  } else if (currency === "GBP") {
+    symbol = "£";
+  } else {
+    throw new Error(`Unsupported currency: ${currency}`);
+  }
+
+  const isNegative = cents < 0;
+  const absCents = Math.abs(cents);
+  const dollars = Math.floor(absCents / 100);
+  const remainingCents = absCents % 100;
+  
+  const dollarsString = dollars.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+  const centsString = remainingCents.toString().padStart(2, "0");
+  
+  const sign = isNegative ? "-" : "";
+  return `${sign}${symbol}${dollarsString}.${centsString}`;
+};
