diff -ruN -x node_modules -x .DS_Store -x .git a/src/money.js b/src/money.js
--- a/src/money.js	2026-11-19 21:42:44
+++ b/src/money.js	2026-11-21 00:45:53
@@ -1 +1,28 @@
 export const toCents = (dollars) => Math.round(dollars * 100);
+
+export const formatMoney = (cents, currency) => {
+  if (!Number.isInteger(cents)) {
+    throw new Error("cents must be an integer");
+  }
+  let symbol;
+  switch (currency) {
+    case "USD":
+      symbol = "$";
+      break;
+    case "EUR":
+      symbol = "€";
+      break;
+    case "GBP":
+      symbol = "£";
+      break;
+    default:
+      throw new Error("Unsupported currency");
+  }
+  const isNegative = cents < 0;
+  const absCents = Math.abs(cents);
+  const major = Math.floor(absCents / 100);
+  const minor = (absCents % 100).toString().padStart(2, "0");
+  const formattedMajor = major.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+  
+  return `${isNegative ? "-" : ""}${symbol}${formattedMajor}.${minor}`;
+};
