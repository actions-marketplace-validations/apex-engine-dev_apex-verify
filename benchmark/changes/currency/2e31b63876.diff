diff -ruN -x node_modules -x .DS_Store -x .git a/src/money.js b/src/money.js
--- a/src/money.js	2026-11-19 21:42:44
+++ b/src/money.js	2026-11-19 21:47:02
@@ -1 +1,25 @@
 export const toCents = (dollars) => Math.round(dollars * 100);
+
+const CURRENCY_FORMATS = {
+  USD: { symbol: "$", fractionDigits: 2 },
+  EUR: { symbol: "€", fractionDigits: 2 },
+  GBP: { symbol: "£", fractionDigits: 2 },
+};
+
+export const formatMoney = (cents, currency) => {
+  if (!Number.isInteger(cents)) {
+    throw new Error("Input must be an integer");
+  }
+
+  const format = CURRENCY_FORMATS[currency];
+  if (!format) {
+    throw new Error("Unsupported currency");
+  }
+
+  const dollars = cents / 100;
+  const formattedAmount = dollars.toFixed(format.fractionDigits);
+  const parts = formattedAmount.split(".");
+  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+
+  return `${format.symbol}${parts.join(".")}`;
+};
