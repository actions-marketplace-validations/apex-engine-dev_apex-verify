diff -ruN -x node_modules -x .DS_Store -x .git a/src/money.js b/src/money.js
--- a/src/money.js	2026-11-19 21:42:44
+++ b/src/money.js	2026-11-19 21:48:03
@@ -1 +1,35 @@
 export const toCents = (dollars) => Math.round(dollars * 100);
+
+function formatMoney(cents, currency) {
+  if (!Number.isInteger(cents)) {
+    throw new Error("Invalid input: cents must be an integer.");
+  }
+
+  let symbol;
+  let locale = 'en-US'; // Using 'en-US' for consistent formatting as per examples
+
+  switch (currency) {
+    case "USD":
+      symbol = "$";
+      break;
+    case "EUR":
+      symbol = "€";
+      break;
+    case "GBP":
+      symbol = "£";
+      break;
+    default:
+      throw new Error(`Unsupported currency code: ${currency}. Supported codes are USD, EUR, GBP.`);
+  }
+
+  // Format the number part (cents / 100)
+  const formattedValue = new Intl.NumberFormat(locale, {
+    style: 'decimal',
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  }).format(cents / 100);
+
+  return `${symbol}${formattedValue}`;
+}
+
+export { formatMoney };
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-19 21:48:08
@@ -1,5 +1,28 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
 import { formatMoney } from "../src/money.js";
+
 test("usd", () => assert.equal(formatMoney(123456, "USD"), "$1,234.56"));
 test("eur", () => assert.equal(formatMoney(500, "EUR"), "€5.00"));
+test("gbp", () => assert.equal(formatMoney(7890, "GBP"), "£78.90"));
+
+// Test for unsupported currency
+test("unsupported currency", () => {
+  assert.throws(() => {
+    formatMoney(1000, "JPY");
+  }, new Error("Unsupported currency code: JPY. Supported codes are USD, EUR, GBP."));
+});
+
+// Test for non-integer cents
+test("non-integer cents", () => {
+  assert.throws(() => {
+    formatMoney(123.45, "USD");
+  }, new Error("Invalid input: cents must be an integer."));
+});
+
+// Test for NaN input
+test("nan input", () => {
+  assert.throws(() => {
+    formatMoney(NaN, "USD");
+  }, new Error("Invalid input: cents must be an integer."));
+});
