diff -ruN -x node_modules -x .DS_Store -x .git a/src/csv.js b/src/csv.js
--- a/src/csv.js	2026-11-19 21:42:44
+++ b/src/csv.js	2026-11-21 00:19:37
@@ -1,6 +1,53 @@
 export function parseCSV(text) {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const result = [];
+  let currentRow = [];
+  let currentCell = '';
+  let inQuotes = false;
+  let hasQuotesInCell = false;
+
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    
+    if (inQuotes) {
+      if (char === '"') {
+        if (i + 1 < text.length && text[i + 1] === '"') {
+          currentCell += '"';
+          i++;
+        } else {
+          inQuotes = false;
+        }
+      } else {
+        currentCell += char;
+      }
+    } else {
+      if (char === '"') {
+        inQuotes = true;
+        hasQuotesInCell = true;
+      } else if (char === ',') {
+        currentRow.push(currentCell);
+        currentCell = '';
+        hasQuotesInCell = false;
+      } else if (char === '\n' || char === '\r') {
+        if (char === '\r' && i + 1 < text.length && text[i + 1] === '\n') {
+          i++;
+        }
+        if (currentRow.length > 0 || currentCell !== '' || hasQuotesInCell) {
+          currentRow.push(currentCell);
+          result.push(currentRow);
+        }
+        currentRow = [];
+        currentCell = '';
+        hasQuotesInCell = false;
+      } else {
+        currentCell += char;
+      }
+    }
+  }
+
+  if (currentRow.length > 0 || currentCell !== '' || hasQuotesInCell) {
+    currentRow.push(currentCell);
+    result.push(currentRow);
+  }
+
+  return result;
 }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/more_csv.test.js b/test/more_csv.test.js
--- a/test/more_csv.test.js	1970-01-01 02:00:00
+++ b/test/more_csv.test.js	2026-11-21 00:16:30
@@ -0,0 +1,9 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseCSV } from "../src/csv.js";
+
+test("plain", () => assert.deepEqual(parseCSV("a,b\n1,2\n"), [["a", "b"], ["1", "2"]]));
+test("quoted comma", () => assert.deepEqual(parseCSV('x,"Smith, John",y\n'), [["x", "Smith, John", "y"]]));
+test("quotes inside quotes", () => assert.deepEqual(parseCSV('a,"b""c",d\n'), [["a", 'b"c', "d"]]));
+test("newlines inside quotes", () => assert.deepEqual(parseCSV('a,"b\nc",d\n'), [["a", "b\nc", "d"]]));
+test("empty lines skipped", () => assert.deepEqual(parseCSV('a,b\n\n1,2\n'), [["a", "b"], ["1", "2"]]));
