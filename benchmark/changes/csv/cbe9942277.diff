diff -ruN -x node_modules -x .DS_Store -x .git a/src/csv.js b/src/csv.js
--- a/src/csv.js	2026-11-19 21:42:44
+++ b/src/csv.js	2026-11-21 00:41:16
@@ -1,6 +1,61 @@
 export function parseCSV(text) {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  if (typeof text !== "string" || text.length === 0) {
+    return [];
+  }
+
+  const rows = [];
+  let currentRow = [];
+  let currentField = "";
+  let inQuotes = false;
+  let fieldQuoted = false;
+
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+
+    if (inQuotes) {
+      if (char === '"') {
+        if (i + 1 < text.length && text[i + 1] === '"') {
+          currentField += '"';
+          i++;
+        } else {
+          inQuotes = false;
+        }
+      } else {
+        currentField += char;
+      }
+    } else {
+      if (char === '"') {
+        if (currentField.length === 0 && !fieldQuoted) {
+          inQuotes = true;
+          fieldQuoted = true;
+        } else {
+          currentField += '"';
+        }
+      } else if (char === ',') {
+        currentRow.push(currentField);
+        currentField = "";
+        fieldQuoted = false;
+      } else if (char === '\r' || char === '\n') {
+        if (char === '\r' && i + 1 < text.length && text[i + 1] === '\n') {
+          i++;
+        }
+        if (currentRow.length > 0 || currentField.length > 0 || fieldQuoted) {
+          currentRow.push(currentField);
+          rows.push(currentRow);
+          currentRow = [];
+          currentField = "";
+          fieldQuoted = false;
+        }
+      } else {
+        currentField += char;
+      }
+    }
+  }
+
+  if (currentRow.length > 0 || currentField.length > 0 || fieldQuoted) {
+    currentRow.push(currentField);
+    rows.push(currentRow);
+  }
+
+  return rows;
 }
