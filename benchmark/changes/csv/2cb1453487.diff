 export function parseCSV(text) {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const result = [];
+  let currentRow = [];
+  let currentField = '';
+  let inQuotes = false;
+  let hasCharsInLine = false;
+  
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    const nextChar = text[i + 1];
+
+    if (char !== '\n' && char !== '\r') {
+      hasCharsInLine = true;
+    }
+
+    if (inQuotes) {
+      if (char === '"') {
+        if (nextChar === '"') {
+          currentField += '"';
+          i++; // skip next quote
+          hasCharsInLine = true;
+        } else {
+          inQuotes = false;
+        }
+      } else {
+        currentField += char;
+      }
+    } else {
+      if (char === '"') {
+        inQuotes = true;
+      } else if (char === ',') {
+        currentRow.push(currentField);
+        currentField = '';
+      } else if (char === '\n') {
+        if (hasCharsInLine || currentRow.length > 0) {
+          currentRow.push(currentField);
+          result.push(currentRow);
+        }
+        currentRow = [];
+        currentField = '';
+        hasCharsInLine = false;
+      } else if (char === '\r') {
+        if (nextChar === '\n') {
+          // Ignore \r if it is followed by \n
+        } else {
+          currentField += char;
+          hasCharsInLine = true;
+        }
+      } else {
+        currentField += char;
+      }
+    }
+  }
+
+  if (hasCharsInLine || currentRow.length > 0) {
+    currentRow.push(currentField);
+    result.push(currentRow);
+  }
+
+  return result;
 }
