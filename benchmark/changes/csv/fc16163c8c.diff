diff -ruN -x node_modules -x .DS_Store -x .git a/src/csv.js b/src/csv.js
--- a/src/csv.js	2026-11-19 21:42:44
+++ b/src/csv.js	2026-11-20 12:16:36
@@ -1,6 +1,44 @@
 export function parseCSV(text) {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows = [];
+  let currentRow = [];
+  let currentField = '';
+  let inQuotes = false;
+
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    const nextChar = text[i + 1];
+
+    if (char === '"') {
+      if (inQuotes && nextChar === '"') {
+        // Handle escaped double quote ("")
+        currentField += '"';
+        i++; // Skip the next quote
+      } else {
+        // Toggle quote status
+        inQuotes = !inQuotes;
+      }
+    } else if (char === "," && !inQuotes) {
+      // End of a field, add to current row
+      currentRow.push(currentField);
+      currentField = '';
+    } else if (char === "\n" && !inQuotes) {
+      // End of a row
+      currentRow.push(currentField);
+      rows.push(currentRow);
+      currentRow = [];
+      currentField = '';
+    } else {
+      // Append character to current field
+      currentField += char;
+    }
+  }
+
+  // Add the last field and row if they exist
+  if (currentField.length > 0 || currentRow.length > 0) {
+    currentRow.push(currentField);
+    rows.push(currentRow);
+  }
+
+  return rows;
 }
+
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-20 12:18:39
@@ -1,5 +1,11 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
 import { parseCSV } from "../src/csv.js";
+
 test("plain", () => assert.deepEqual(parseCSV("a,b\n1,2\n"), [["a", "b"], ["1", "2"]]));
+
 test("quoted comma", () => assert.deepEqual(parseCSV('x,"Smith, John",y\n'), [["x", "Smith, John", "y"]]));
+
+test("escaped quotes", () => assert.deepEqual(parseCSV("field1,\"He said, \"\"Hello!\"\"",field3"), [["field1", "He said, \"Hello!\"", "field3"]]));
+
+test("quoted newline", () => assert.deepEqual(parseCSV('fieldA,"line1\nline2",fieldC\n'), [["fieldA", "line1\nline2", "fieldC"]]));
