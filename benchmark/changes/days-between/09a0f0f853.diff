diff -ruN -x node_modules -x .DS_Store -x .git a/test/daysbetween-src-dates.test.js b/test/daysbetween-src-dates.test.js
--- a/test/daysbetween-src-dates.test.js	1970-01-01 02:00:00
+++ b/test/daysbetween-src-dates.test.js	2026-11-20 14:12:17
@@ -0,0 +1,36 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { daysBetween } from "../src/dates.js";
+
+// Set timezone to New York to reliably reproduce the DST bug
+process.env.TZ = "America/New_York";
+
+test("DST spring forward - should return 2 days (fails on current code)", () => {
+  assert.equal(daysBetween("2024-03-09", "2024-03-11"), 2);
+});
+
+test("Normal range - should return correct days (pins nearby behavior)", () => {
+  assert.equal(daysBetween("2024-01-01", "2024-01-31"), 30);
+});
+
+test("Same day - should return 0 (pins nearby behavior)", () => {
+  assert.equal(daysBetween("2024-05-10", "2024-05-10"), 0);
+});
+
+test("Repeating the operation many times keeps working the same way each time", () => {
+  const expected = daysBetween("2024-03-09", "2024-03-11");
+  for (let i = 0; i < 50; i++) {
+    assert.equal(daysBetween("2024-03-09", "2024-03-11"), expected);
+  }
+});
+
+test("Works on empty input (a empty): no throw, and the same result shape", () => {
+  const result = daysBetween("", "2024-01-01");
+  assert.equal(typeof result, "number");
+});
+
+test("The result keeps its type and format", () => {
+  const result = daysBetween("2024-01-01", "2024-01-02");
+  assert.equal(typeof result, "number");
+  assert.equal(Number.isInteger(result), true);
+});
