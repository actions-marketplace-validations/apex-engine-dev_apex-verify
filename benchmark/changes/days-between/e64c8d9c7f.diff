diff -ruN -x node_modules -x .DS_Store -x .git a/src/dates.js b/src/dates.js
--- a/src/dates.js	2026-11-19 21:42:44
+++ b/src/dates.js	2026-11-21 01:09:04
@@ -1,7 +1,9 @@
 function parse(s) {
   const [y, m, d] = s.split("-").map(Number);
-  return new Date(y, m - 1, d);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  date.setUTCFullYear(y);
+  return date;
 }
 export function daysBetween(a, b) {
-  return Math.floor((parse(b) - parse(a)) / 86400000);
+  return Math.round((parse(b) - parse(a)) / 86400000) || 0;
 }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-21 01:10:36
@@ -1,4 +1,37 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
 import { daysBetween } from "../src/dates.js";
+
 test("simple", () => assert.equal(daysBetween("2024-01-01", "2024-01-31"), 30));
+
+test("march DST transition", () => {
+  assert.equal(daysBetween("2024-03-09", "2024-03-11"), 2);
+});
+
+test("november DST transition", () => {
+  assert.equal(daysBetween("2024-11-02", "2024-11-04"), 2);
+});
+
+test("same day", () => {
+  assert.equal(daysBetween("2024-03-09", "2024-03-09"), 0);
+  assert.ok(Object.is(daysBetween("2024-03-09", "2024-03-09"), 0));
+});
+
+test("negative / reversed range", () => {
+  assert.equal(daysBetween("2024-03-11", "2024-03-09"), -2);
+});
+
+test("leap year boundary", () => {
+  assert.equal(daysBetween("2024-02-28", "2024-03-01"), 2);
+  assert.equal(daysBetween("2023-02-28", "2023-03-01"), 1);
+});
+
+test("full year across leap year", () => {
+  assert.equal(daysBetween("2024-01-01", "2025-01-01"), 366);
+  assert.equal(daysBetween("2023-01-01", "2024-01-01"), 365);
+});
+
+test("early year with 1 or 2 digits", () => {
+  assert.equal(daysBetween("0050-01-01", "0050-01-03"), 2);
+});
+
