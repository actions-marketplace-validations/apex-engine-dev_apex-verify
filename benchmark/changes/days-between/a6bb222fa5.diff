 function parse(s) {
+  if (!s) return NaN;
   const [y, m, d] = s.split("-").map(Number);
-  return new Date(y, m - 1, d);
+  return new Date(Date.UTC(y, m - 1, d));
 }
 export function daysBetween(a, b) {
-  return Math.floor((parse(b) - parse(a)) / 86400000);
+  const dateA = parse(a);
