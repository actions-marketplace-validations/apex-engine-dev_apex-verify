diff -ruN -x node_modules -x .DS_Store -x .git a/src/dates.js b/src/dates.js
--- a/src/dates.js	2026-11-19 21:42:44
+++ b/src/dates.js	2026-11-20 12:23:13
@@ -1,7 +1,10 @@
 function parse(s) {
+  // Use UTC to avoid timezone issues.
   const [y, m, d] = s.split("-").map(Number);
-  return new Date(y, m - 1, d);
+  return new Date(Date.UTC(y, m - 1, d));
 }
 export function daysBetween(a, b) {
-  return Math.floor((parse(b) - parse(a)) / 86400000);
+  // Calculate the difference in milliseconds and convert to days.
+  // Using UTC dates ensures that DST changes do not affect the calculation.
+  return Math.floor((parse(b) - parse(a)) / (1000 * 60 * 60 * 24));
 }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/daysbetween-src-dates.test.js b/test/daysbetween-src-dates.test.js
--- a/test/daysbetween-src-dates.test.js	1970-01-01 02:00:00
+++ b/test/daysbetween-src-dates.test.js	2026-11-20 12:23:13
@@ -0,0 +1,44 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { daysBetween } from "../src/dates.js";
+
+// Force the timezone to New York to reliably reproduce the DST bug
+// regardless of the machine's local timezone.
+process.env.TZ = "America/New_York";
+
+test("fails on DST transition (spring forward 2024)", () => {
+  // March 10, 2024 is the start of DST in New York.
+  // The day is 23 hours long, causing Math.floor to return 1 instead of 2.
+  assert.equal(daysBetween("2024-03-09", "2024-03-11"), 2);
+});
+
+test("fails on DST transition (spring forward 2023)", () => {
+  // March 12, 2023 was the start of DST in New York.
+  assert.equal(daysBetween("2023-03-11", "2023-03-13"), 2);
+});
+
+test("pins normal behavior (same month, no DST)", () => {
+  assert.equal(daysBetween("2024-01-01", "2024-01-10"), 9);
+});
+
+test("pins normal behavior (different months, no DST)", () => {
+  assert.equal(daysBetween("2024-05-01", "2024-06-01"), 31);
+});
+
+test("repeating the operation many times keeps working the same way", () => {
+  for (let i = 0; i < 50; i++) {
+    assert.equal(daysBetween("2024-01-01", "2024-01-10"), 9);
+  }
+});
+
+test("works on empty input (a empty): no throw, and the same result shape", () => {
+  const result = daysBetween("", "2024-03-11");
+  // Invalid dates result in NaN, which is of type 'number'
+  assert.equal(typeof result, "number");
+});
+
+test("the result keeps its type and format", () => {
+  const result = daysBetween("2024-01-01", "2024-01-10");
+  assert.equal(typeof result, "number");
+  assert.equal(Number.isInteger(result), true);
+});
