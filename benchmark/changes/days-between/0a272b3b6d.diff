diff -ruN -x node_modules -x .DS_Store -x .git a/src/dates.js b/src/dates.js
--- a/src/dates.js	2026-11-19 21:42:44
+++ b/src/dates.js	2026-11-19 21:49:03
@@ -1,7 +1,11 @@
-function parse(s) {
-  const [y, m, d] = s.split("-").map(Number);
-  return new Date(y, m - 1, d);
+function parseUTC(s) {
+  const [y, m, d] = s.split('-').map(Number);
+  return new Date(Date.UTC(y, m - 1, d));
 }
+
 export function daysBetween(a, b) {
-  return Math.floor((parse(b) - parse(a)) / 86400000);
+  const dateA = parseUTC(a);
+  const dateB = parseUTC(b);
+  const diffTime = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffTime / (1000 * 60 * 60 * 24));
 }
