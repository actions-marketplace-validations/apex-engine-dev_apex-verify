diff -ruN -x node_modules -x .DS_Store -x .git a/src/retry.js b/src/retry.js
--- a/src/retry.js	2026-11-19 21:42:44
+++ b/src/retry.js	2026-11-20 18:46:07
@@ -1 +1,26 @@
 export const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+export async function retry(fn, options = {}) {
+  const {
+    retries = 0,
+    delayMs = 0,
+    factor = 2,
+    shouldRetry,
+  } = options;
+
+  let delay = delayMs;
+  for (let attempt = 1; ; attempt++) {
+    try {
+      return await fn(attempt);
+    } catch (err) {
+      if (attempt > retries) {
+        throw err;
+      }
+      if (shouldRetry && !(await shouldRetry(err))) {
+        throw err;
+      }
+      await sleep(delay);
+      delay *= factor;
+    }
+  }
+}
diff -ruN -x node_modules -x .DS_Store -x .git a/test/async-helper-retry.test.js b/test/async-helper-retry.test.js
--- a/test/async-helper-retry.test.js	1970-01-01 02:00:00
+++ b/test/async-helper-retry.test.js	2026-11-20 18:46:07
@@ -0,0 +1,76 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { sleep, retry } from "../src/retry.js";
+
+test("sleep resolves after given ms", async () => {
+  const start = Date.now();
+  await sleep(10);
+  assert.ok(Date.now() - start >= 5);
+});
+
+test("retry passes attempt number and returns result", async () => {
+  const attempts = [];
+  const result = await retry(async (attempt) => {
+    attempts.push(attempt);
+    if (attempt < 3) throw new Error("fail");
+    return "success";
+  }, { retries: 2, delayMs: 1 });
+  
+  assert.deepEqual(attempts, [1, 2, 3]);
+  assert.equal(result, "success");
+});
+
+test("retry respects retries limit and throws last error", async () => {
+  let count = 0;
+  await assert.rejects(
+    retry(async () => {
+      count++;
+      throw new Error(`err${count}`);
+    }, { retries: 1, delayMs: 1 }),
+    /err2/
+  );
+  assert.equal(count, 2);
+});
+
+test("retry respects shouldRetry and aborts early", async () => {
+  let count = 0;
+  await assert.rejects(
+    retry(async () => {
+      count++;
+      throw new Error("fatal");
+    }, {
+      retries: 5,
+      delayMs: 1,
+      shouldRetry: (err) => err.message !== "fatal"
+    }),
+    /fatal/
+  );
+  assert.equal(count, 1);
+});
+
+test("edge case: repeating the operation many times", async () => {
+  for (let i = 0; i < 50; i++) {
+    let count = 0;
+    const res = await retry(async () => {
+      count++;
+      if (count < 2) throw new Error("fail");
+      return i;
+    }, { retries: 1, delayMs: 1 });
+    
+    assert.equal(res, i);
+    assert.equal(count, 2);
+  }
+});
+
+test("edge case: works on empty input", async () => {
+  const res = await retry(async () => {}, { retries: 0, delayMs: 0 });
+  assert.equal(res, undefined);
+});
+
+test("edge case: result keeps its type and format", async () => {
+  const obj = { a: 1, b: "two", c: [3, 4] };
+  const res = await retry(async () => obj, { retries: 1, delayMs: 1 });
+  
+  assert.equal(res, obj);
+  assert.deepEqual(res, { a: 1, b: "two", c: [3, 4] });
+});
