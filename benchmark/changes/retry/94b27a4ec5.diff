diff -ruN -x node_modules -x .DS_Store -x .git a/src/retry.js b/src/retry.js
--- a/src/retry.js	2026-11-19 21:42:44
+++ b/src/retry.js	2026-11-19 22:08:19
@@ -1 +1,43 @@
 export const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+export const retry = async (fn, options) => {
+  const {
+    retries = 2, // Default to 2 extra attempts (3 total calls)
+    delayMs = 100, // Default initial delay
+    factor = 2, // Default multiplier
+    shouldRetry, // Optional function to decide if retry is needed
+  } = options;
+
+  let attempt = 1;
+  let currentDelay = delayMs;
+  let lastError;
+
+  while (attempt <= retries + 1) {
+    try {
+      const result = await fn(attempt);
+      return result; // Success, return the result
+    } catch (error) {
+      lastError = error;
+
+      // Check if we should retry based on shouldRetry function
+      if (shouldRetry && !shouldRetry(error)) {
+        throw error; // Reject immediately if shouldRetry returns false
+      }
+
+      // If this was the last possible attempt, reject
+      if (attempt > retries) {
+        throw lastError;
+      }
+
+      // Wait before the next retry
+      await sleep(currentDelay);
+
+      // Increase delay for the next attempt
+      currentDelay *= factor;
+      attempt++;
+    }
+  }
+  // This part should ideally not be reached if the loop logic is correct, 
+  // but as a fallback, throw the last error if something went wrong.
+  throw lastError;
+};
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-19 22:08:31
@@ -1,9 +1,36 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
 import { retry } from "../src/retry.js";
+
 test("succeeds after failures", async () => {
   let n = 0;
   const r = await retry(async () => { if (++n < 3) throw new Error("x"); return "ok"; }, { retries: 3, delayMs: 1 });
   assert.equal(r, "ok");
   assert.equal(n, 3);
+});
+
+test("rejects immediately if shouldRetry returns false", async () => {
+  let n = 0;
+  const specificError = new Error("This should not be retried");
+  try {
+    await retry(
+      async () => {
+        n++;
+        throw specificError;
+      },
+      {
+        retries: 5, // Many retries to ensure it would have retried if not for shouldRetry
+        delayMs: 1,
+        shouldRetry: (err) => {
+          // Only retry if the error is NOT specificError
+          return err !== specificError;
+        },
+      }
+    );
+    // If we reach here, the test failed because it didn't reject.
+    assert.fail("Should have rejected");
+  } catch (error) {
+    assert.equal(error, specificError, "Should have rejected with the specific error.");
+    assert.equal(n, 1, "Function should only have been called once.");
+  }
 });
