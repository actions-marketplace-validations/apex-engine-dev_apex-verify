diff -ruN -x node_modules -x .DS_Store -x .git a/src/lru.js b/src/lru.js
--- a/src/lru.js	2026-11-19 21:42:44
+++ b/src/lru.js	2026-11-20 15:30:53
@@ -4,10 +4,22 @@
     this.map = new Map();
   }
   get(key) {
-    return this.map.get(key);
+    if (!this.map.has(key)) {
+      return undefined;
+    }
+    const value = this.map.get(key);
+    this.map.delete(key);
+    this.map.set(key, value);
+    return value;
   }
   set(key, value) {
-    if (this.map.size >= this.capacity) {
+    if (this.capacity <= 0) {
+      return;
+    }
+    if (this.map.has(key)) {
+      this.map.delete(key);
+    }
+    while (this.map.size >= this.capacity) {
       const oldest = this.map.keys().next().value;
       this.map.delete(oldest);
     }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-20 15:32:23
@@ -1,9 +1,53 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
 import { LRUCache } from "../src/lru.js";
+
 test("evicts oldest", () => {
   const c = new LRUCache(2);
   c.set("a", 1); c.set("b", 2); c.set("c", 3);
   assert.equal(c.get("a"), undefined);
   assert.equal(c.get("c"), 3);
 });
+
+test("reading an entry marks it as most recently used", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  assert.equal(c.get("a"), 1); // "a" is accessed, making "b" the least recently used
+  c.set("c", 3); // should evict "b", not "a"
+  assert.equal(c.get("a"), 1);
+  assert.equal(c.get("b"), undefined);
+  assert.equal(c.get("c"), 3);
+  assert.equal(c.size, 2);
+});
+
+test("re-setting an existing key when full does not evict unrelated entries", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  c.set("a", 10); // re-set existing key "a"
+  assert.equal(c.size, 2);
+  assert.equal(c.get("b"), 2); // "b" should not be evicted
+  assert.equal(c.get("a"), 10);
+});
+
+test("re-setting an existing key marks it as most recently used", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  c.set("a", 10); // "a" is updated, making "b" the least recently used
+  c.set("c", 3);  // should evict "b", not "a"
+  assert.equal(c.get("b"), undefined);
+  assert.equal(c.get("a"), 10);
+  assert.equal(c.get("c"), 3);
+  assert.equal(c.size, 2);
+});
+
+test("getting non-existent key returns undefined without altering cache", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  assert.equal(c.get("missing"), undefined);
+  assert.equal(c.size, 1);
+  assert.equal(c.get("a"), 1);
+});
+
