diff -ruN -x node_modules -x .DS_Store -x .git a/test/our-lrucache-src.test.js b/test/our-lrucache-src.test.js
--- a/test/our-lrucache-src.test.js	1970-01-01 02:00:00
+++ b/test/our-lrucache-src.test.js	2026-11-20 07:47:54
@@ -0,0 +1,85 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { LRUCache } from "../src/lru.js";
+
+test("reading a key updates its recency", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  
+  // Reading 'a' should make it the most recently used
+  c.get("a"); 
+  
+  // Adding 'c' should evict 'b' (the least recently used), not 'a'
+  c.set("c", 3); 
+  
+  assert.equal(c.get("b"), undefined);
+  assert.equal(c.get("a"), 1);
+  assert.equal(c.get("c"), 3);
+});
+
+test("updating an existing key does not evict unrelated entries", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  
+  // Updating 'b' should just update its value and recency, without increasing size
+  c.set("b", 20); 
+  
+  // 'a' should still be in the cache
+  assert.equal(c.get("a"), 1);
+  assert.equal(c.get("b"), 20);
+  assert.equal(c.size, 2);
+});
+
+test("evicts oldest when capacity is reached (pinning)", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  c.set("c", 3);
+  
+  assert.equal(c.get("a"), undefined);
+  assert.equal(c.get("b"), 2);
+  assert.equal(c.get("c"), 3);
+  assert.equal(c.size, 2);
+});
+
+test("repeating the operation many times keeps working", () => {
+  const c = new LRUCache(3);
+  
+  for (let i = 0; i < 50; i++) {
+    c.set(`k${i}`, i);
+    // Keep 'k0' alive by reading it every iteration
+    c.get("k0");
+  }
+  
+  assert.equal(c.size, 3);
+  assert.equal(c.get("k0"), 0);
+  assert.equal(c.get("k49"), 49);
+  assert.equal(c.get("k48"), 48);
+  assert.equal(c.get("k47"), undefined);
+});
+
+test("works on empty input", () => {
+  const c = new LRUCache(2);
+  
+  assert.doesNotThrow(() => {
+    c.get("nonexistent");
+  });
+  
+  assert.equal(c.get("nonexistent"), undefined);
+  assert.equal(c.size, 0);
+});
+
+test("result keeps its type and format", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  
+  const val = c.get("a");
+  assert.equal(typeof val, "number");
+  
+  const missing = c.get("b");
+  assert.equal(typeof missing, "undefined");
+  
+  assert.equal(typeof c.size, "number");
+});
