 export class LRUCache {
   constructor(capacity) {
     this.capacity = capacity;
+    // Use a Map to store key-value pairs.
+    // The order of insertion in a Map is preserved, which is crucial for LRU.
     this.map = new Map();
   }
+
   get(key) {
-    return this.map.get(key);
+    // If the key doesn't exist, return undefined.
+    if (!this.map.has(key)) {
+      return undefined;
+    }
+
+    // Get the value associated with the key.
+    const value = this.map.get(key);
+
+    // Remove the key from its current position and re-insert it at the end.
+    // This marks it as the most recently used.
+    this.map.delete(key);
+    this.map.set(key, value);
+
+    return value;
   }
+
   set(key, value) {
-    if (this.map.size >= this.capacity) {
-      const oldest = this.map.keys().next().value;
-      this.map.delete(oldest);
+    // If the key already exists, remove it first to update its recency.
+    if (this.map.has(key)) {
+      this.map.delete(key);
+    } else if (this.map.size >= this.capacity) {
+      // If the cache is full and the key is new, evict the least recently used item.
+      // The first item in the Map's iteration order is the oldest.
+      const oldestKey = this.map.keys().next().value;
+      this.map.delete(oldestKey);
     }
+
+    // Add the new key-value pair or re-insert the existing key at the end.
     this.map.set(key, value);
   }
+
   get size() {
     return this.map.size;
   }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/our-lrucache-src.test.js b/test/our-lrucache-src.test.js
--- a/test/our-lrucache-src.test.js	1970-01-01 02:00:00
+++ b/test/our-lrucache-src.test.js	2026-11-20 08:00:57
@@ -0,0 +1,87 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { LRUCache } from "../src/lru.js";
+
+// Failing tests that reproduce the bug
+test("get updates recency", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  
+  // Reading 'a' should make it the most recently used
+  c.get("a"); 
+  
+  // Inserting 'c' should evict 'b', not 'a'
+  c.set("c", 3); 
+  
+  assert.equal(c.get("b"), undefined);
+  assert.equal(c.get("a"), 1);
+});
+
+test("set on existing key does not evict unrelated entry", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  
+  // Re-setting 'b' when full should just update 'b' and its recency, keeping 'a'
+  c.set("b", 22); 
+  
+  assert.equal(c.get("a"), 1);
+  assert.equal(c.get("b"), 22);
+  assert.equal(c.size, 2);
+});
+
+// Pinning tests for nearby behavior that works today
+test("normal eviction works", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  c.set("c", 3);
+  
+  assert.equal(c.get("a"), undefined);
+  assert.equal(c.get("b"), 2);
+  assert.equal(c.get("c"), 3);
+});
+
+test("size property works correctly", () => {
+  const c = new LRUCache(2);
+  assert.equal(c.size, 0);
+  c.set("a", 1);
+  assert.equal(c.size, 1);
+  c.set("b", 2);
+  assert.equal(c.size, 2);
+});
+
+// Edge cases
+test("repeating the operation many times", () => {
+  const c = new LRUCache(2);
+  c.set("keep", 1);
+  
+  for (let i = 0; i < 50; i++) {
+    c.set("temp" + i, i);
+    // Accessing 'keep' in every iteration should prevent it from ever being evicted
+    c.get("keep");
+  }
+  
+  assert.equal(c.get("keep"), 1);
+});
+
+test("works on empty input", () => {
+  const c = new LRUCache(2);
+  
+  assert.doesNotThrow(() => {
+    assert.equal(c.get("nonexistent"), undefined);
+    assert.equal(c.get(), undefined);
+  });
+  
+  assert.equal(c.size, 0);
+});
+
+test("result keeps its type and format", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  
+  const val = c.get("a");
+  assert.equal(typeof val, "number");
+  assert.equal(typeof c.size, "number");
+});
