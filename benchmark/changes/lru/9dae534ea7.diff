diff -ruN -x node_modules -x .DS_Store -x .git a/test/our-lrucache-src.test.js b/test/our-lrucache-src.test.js
--- a/test/our-lrucache-src.test.js	1970-01-01 02:00:00
+++ b/test/our-lrucache-src.test.js	2026-11-20 12:28:46
@@ -0,0 +1,68 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { LRUCache } from "../src/lru.js";
+
+test("get updates recentness so recently read items are not evicted", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  c.get("a"); // read recently
+  c.set("c", 3); // should evict 'b', not 'a'
+  assert.equal(c.get("b"), undefined);
+  assert.equal(c.get("a"), 1);
+});
+
+test("set on existing key updates recentness and does not evict unrelated entry", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  c.set("b", 20); // re-setting a key that already exists
+  assert.equal(c.get("a"), 1); // currently 'a' gets pushed out incorrectly
+  assert.equal(c.get("b"), 20);
+  assert.equal(c.size, 2);
+});
+
+test("normal case: evicts oldest when capacity is reached", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  c.set("c", 3);
+  assert.equal(c.get("a"), undefined);
+  assert.equal(c.get("b"), 2);
+  assert.equal(c.get("c"), 3);
+  assert.equal(c.size, 2);
+});
+
+test("edge case: repeating the operation many times keeps working the same way each time", () => {
+  const c = new LRUCache(2);
+  c.set("keep", "value");
+  for (let i = 0; i < 50; i++) {
+    c.set("temp" + i, i);
+    c.get("keep"); // keep it recently used
+  }
+  assert.equal(c.get("keep"), "value");
+  assert.equal(c.get("temp49"), 49);
+  assert.equal(c.get("temp48"), undefined);
+  assert.equal(c.size, 2);
+});
+
+test("edge case: works on empty input: no throw, and the same result shape", () => {
+  const c = new LRUCache(2);
+  assert.doesNotThrow(() => {
+    const res = c.get("nonexistent");
+    assert.equal(res, undefined);
+  });
+  assert.equal(c.size, 0);
+});
+
+test("edge case: the result keeps its type and format", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  const val = c.get("a");
+  const size = c.size;
+  
+  assert.equal(typeof val, "number");
+  assert.equal(typeof size, "number");
+  assert.equal(val, 1);
+  assert.equal(size, 1);
+});
