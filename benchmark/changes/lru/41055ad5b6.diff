diff -ruN -x node_modules -x .DS_Store -x .git a/src/lru.js b/src/lru.js
--- a/src/lru.js	2026-11-19 21:42:44
+++ b/src/lru.js	2026-11-21 02:30:35
@@ -3,16 +3,30 @@
     this.capacity = capacity;
     this.map = new Map();
   }
+
   get(key) {
-    return this.map.get(key);
+    if (!this.map.has(key)) {
+      return undefined;
+    }
+    const value = this.map.get(key);
+    this.map.delete(key);
+    this.map.set(key, value);
+    return value;
   }
+
   set(key, value) {
-    if (this.map.size >= this.capacity) {
+    if (this.capacity <= 0) {
+      return;
+    }
+    if (this.map.has(key)) {
+      this.map.delete(key);
+    } else if (this.map.size >= this.capacity) {
       const oldest = this.map.keys().next().value;
       this.map.delete(oldest);
     }
     this.map.set(key, value);
   }
+
   get size() {
     return this.map.size;
   }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-21 02:32:09
@@ -1,9 +1,77 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
 import { LRUCache } from "../src/lru.js";
+
 test("evicts oldest", () => {
   const c = new LRUCache(2);
   c.set("a", 1); c.set("b", 2); c.set("c", 3);
   assert.equal(c.get("a"), undefined);
+  assert.equal(c.get("c"), 3);
+  assert.equal(c.size, 2);
+});
+
+test("reading a key marks it as recently used so it is not evicted", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  // Access "a", making "b" the least recently used
+  assert.equal(c.get("a"), 1);
+  // Adding "c" should evict "b", not "a"
+  c.set("c", 3);
+  assert.equal(c.get("b"), undefined);
+  assert.equal(c.get("a"), 1);
+  assert.equal(c.get("c"), 3);
+});
+
+test("re-setting an existing key updates value without evicting entries and marks it as recently used", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  // Re-setting "a" when cache is full should not evict "b"
+  c.set("a", 10);
+  assert.equal(c.size, 2);
+  assert.equal(c.get("b"), 2);
+  assert.equal(c.get("a"), 10);
+
+  // Now "b" was read before "a" was read, so "b" is less recently used than "a".
+  // Adding "d" should evict "b"
+  c.set("d", 4);
+  assert.equal(c.get("b"), undefined);
+  assert.equal(c.get("a"), 10);
+  assert.equal(c.get("d"), 4);
+});
+
+test("re-setting existing key marks it as MRU without reading", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  // Re-set "a", making "a" MRU and "b" LRU
+  c.set("a", 10);
+  c.set("c", 3);
+  assert.equal(c.get("b"), undefined);
+  assert.equal(c.get("a"), 10);
+  assert.equal(c.get("c"), 3);
+});
+
+test("handles capacity of 1", () => {
+  const c = new LRUCache(1);
+  c.set("a", 1);
+  assert.equal(c.get("a"), 1);
+  c.set("b", 2);
+  assert.equal(c.get("a"), undefined);
+  assert.equal(c.get("b"), 2);
+  c.set("b", 20);
+  assert.equal(c.get("b"), 20);
+  assert.equal(c.size, 1);
+});
+
+test("returns undefined for non-existent keys without altering order", () => {
+  const c = new LRUCache(2);
+  c.set("a", 1);
+  c.set("b", 2);
+  assert.equal(c.get("nonexistent"), undefined);
+  c.set("c", 3);
+  assert.equal(c.get("a"), undefined);
+  assert.equal(c.get("b"), 2);
   assert.equal(c.get("c"), 3);
 });
