diff -ruN a/slugify.js b/slugify.js
--- a/slugify.js	2026-11-23 10:15:55
+++ b/slugify.js	2026-11-23 10:15:55
@@ -33,7 +33,22 @@
     var slug = string.normalize().split('')
       // replace characters based on charMap
       .reduce(function (result, ch) {
-        return result + (locale[ch] || charMap[ch] ||  (ch === replacement ? ' ' : ch))
+        var charToProcess = locale[ch] || charMap[ch]; // Get mapped char (locale has precedence)
+
+        if (charToProcess === undefined) { // If no mapping, use original char
