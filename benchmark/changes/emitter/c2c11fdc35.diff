diff -ruN -x node_modules -x .DS_Store -x .git a/test/emitter.test.js b/test/emitter.test.js
--- a/test/emitter.test.js	1970-01-01 02:00:00
+++ b/test/emitter.test.js	2026-11-21 01:57:01
@@ -0,0 +1,22 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { Emitter } from "../src/emitter.js";
+
+test("once firing does not skip next listener", () => {
+  const e = new Emitter();
+  const got = [];
+  e.once("x", () => got.push(1));
+  e.on("x", () => got.push(2));
+  e.emit("x");
+  assert.deepEqual(got, [1, 2]);
+});
+
+test("off removes once listener", () => {
+  const e = new Emitter();
+  const got = [];
+  const fn = () => got.push(1);
+  e.once("x", fn);
+  e.off("x", fn);
+  e.emit("x");
+  assert.deepEqual(got, []);
+});
