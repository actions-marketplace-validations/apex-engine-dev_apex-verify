--- a/src/emitter.js	2026-11-19 21:42:44
+++ b/src/emitter.js	2026-11-21 02:00:01
@@ -11,18 +11,19 @@
       this.off(event, wrapper);
       fn(...args);
     };
+    wrapper.fn = fn;
     return this.on(event, wrapper);
   }
   off(event, fn) {
     const list = this.handlers[event];
     if (!list) return this;
