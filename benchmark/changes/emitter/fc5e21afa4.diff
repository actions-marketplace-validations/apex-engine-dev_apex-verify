+      this.off(event, wrapper);
     };
-    return this.on(event, wrapper);
+    // Store the wrapper, mark as 'once', and store originalFn for `off`.
+    (this.handlers[event] ??= []).push({ handler: wrapper, isOnce: true, originalFn: fn });
