+
+    for (const entry of list) {
+      let shouldRemove = false;
+      if (entry.isOnce) {
+        // If it's a 'once' handler, we can remove it if:
+        // a) The provided `fn` is the original function (`entry.originalFn === fn`)
+        // b) The provided `fn` is the wrapper itself (`entry.handler === fn`)
+        if (entry.originalFn === fn || entry.handler === fn) {
+          shouldRemove = true;
+        }
+      } else {
+        // If it's a regular handler, we can remove it if:
+        // a) The provided `fn` is the handler (`entry.handler === fn`)
+        if (entry.handler === fn) {
+          shouldRemove = true;
+        }
+      }
+
+      if (shouldRemove) {
+        removed = true;
+      } else {
+        newList.push(entry); // Keep this entry
+      }
+    }
+
+    if (removed) {
