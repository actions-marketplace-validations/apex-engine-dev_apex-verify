diff -ruN -x node_modules -x .DS_Store -x .git a/test/emitter.test.js b/test/emitter.test.js
--- a/test/emitter.test.js	1970-01-01 02:00:00
+++ b/test/emitter.test.js	2026-11-19 21:55:20
@@ -0,0 +1,190 @@
+
+// Import Node.js test module and assert
+import test from 'node:test';
+import assert from 'node:assert';
+
+// Simple mock function to replace jest.fn()
+function createMockFn() {
+    let callCount = 0;
+    let calls = [];
+    const mock = function(...args) {
+        callCount++;
+        calls.push(args);
+    };
+    // Expose call count and calls array for assertions
+    Object.defineProperty(mock, 'callCount', {
+        get: () => callCount
+    });
+    Object.defineProperty(mock, 'calls', {
+        get: () => calls
+    });
+    return mock;
+}
+
+import { Emitter } from '../src/emitter.js';
+
+test.describe('Emitter', () => {
+    let emitter;
+
+    // Manual setup for each test
+    const setupEmitter = () => {
+        emitter = new Emitter();
+    };
+
+    // Test case for Bug 1: when a listener registered with once() fires, the next listener for the same event sometimes does not run.
+    test('should allow subsequent listeners to run after a once() listener fires', () => {
+        setupEmitter();
+        const event = 'myEvent';
+        const onceFn = createMockFn();
+        const onFn = createMockFn();
+
+        emitter.once(event, onceFn);
+        emitter.on(event, onFn);
+
+        // Emit the event for the first time
+        emitter.emit(event);
+
+        // Assert that both listeners were called
+        assert.strictEqual(onceFn.callCount, 1, 'onceFn should be called once');
+        assert.strictEqual(onFn.callCount, 1, 'onFn should be called once');
+
+        // Emit the event again - only the 'on' listener should remain and be called
+        emitter.emit(event);
+        assert.strictEqual(onceFn.callCount, 1, 'onceFn should not be called again'); // onceFn should not be called again
+        assert.strictEqual(onFn.callCount, 2, 'onFn should be called a second time');
+    });
+
+    // Test case for Bug 2: off(event, fn) does nothing if fn was registered with once().
+    test('should correctly remove a listener registered with once() using off(event, originalFn)', () => {
+        setupEmitter();
+        const event = 'myEvent';
+        const onceFn = createMockFn();
+
+        emitter.once(event, onceFn);
+
+        // Emit before removing to ensure it was registered
+        emitter.emit(event);
+        assert.strictEqual(onceFn.callCount, 1, 'onceFn should be called once before removal'); // Should have been called once
+
+        // Re-register it to test removal
+        emitter.once(event, onceFn);
+        // Remove the 'once' listener using its original function
+        emitter.off(event, onceFn);
+
+        // Emit the event again - the listener should NOT be called
+        emitter.emit(event);
+        assert.strictEqual(onceFn.callCount, 1, 'onceFn should not be called after removal'); // Should NOT be called again
+    });
+
+    // Test for off(event, wrapperFn) - internal detail, but good to check
+    test('should correctly remove a listener registered with once() using off(event, wrapperFn)', () => {
+        setupEmitter();
+        const event = 'myEvent';
+        const originalFn = createMockFn();
+        let wrapperFn = null; // To capture the wrapper function
+
+        // Temporarily override emitter methods to capture wrapperFn
+        const originalOnce = emitter.once;
+        const originalOn = emitter.on;
+
+        // Mock `once` to capture the wrapper
+        emitter.once = function(evt, fn) {
+            const wrapper = (...args) => {
+                fn(...args);
+                // Crucially, `off` must correctly remove the wrapper when called from within the wrapper.
+                this.off(evt, wrapper);
+            };
+            wrapperFn = wrapper; // Capture the wrapper
+            return this.on(evt, wrapper); // Use original `on` to add the handler object
+        };
+
+        // Use original `on` from closure
+        emitter.on = originalOn;
+
+        emitter.once(event, originalFn); // This will set wrapperFn
+
+        // Ensure wrapperFn was captured
+        assert(wrapperFn !== null, 'wrapperFn should be captured');
+
+        // Remove the listener using the captured wrapper function
+        emitter.off(event, wrapperFn);
+
+        // Emit the event - the listener should NOT be called
+        emitter.emit(event);
+        assert.strictEqual(originalFn.callCount, 0, 'originalFn should not be called after wrapper removal');
+
+        // Restore original methods
+        emitter.once = originalOnce;
+        emitter.on = originalOn;
+    });
+
+
+    // Test suite for basic Emitter functionality to ensure no regressions
+    test.describe('Basic Emitter Functionality', () => {
+        test('should register and emit an event', () => {
+            setupEmitter();
+            const event = 'testEvent';
+            const handler = createMockFn();
+            emitter.on(event, handler);
+            emitter.emit(event);
+            assert.strictEqual(handler.callCount, 1, 'handler should be called once');
+        });
+
+        test('should pass arguments to listeners', () => {
+            setupEmitter();
+            const event = 'testEvent';
+            const handler = createMockFn();
+            const args = ['arg1', 123, { key: 'value' }];
+            emitter.on(event, handler);
+            emitter.emit(event, ...args);
+            // Check call count
+            assert.strictEqual(handler.callCount, 1, 'handler should be called once');
+            // Check arguments
+            assert.deepStrictEqual(handler.calls[0], args, 'handler should be called with correct arguments');
+        });
+
+        test('should handle multiple listeners for the same event', () => {
+            setupEmitter();
+            const event = 'testEvent';
+            const handler1 = createMockFn();
+            const handler2 = createMockFn();
+            emitter.on(event, handler1);
+            emitter.on(event, handler2);
+            emitter.emit(event);
+            assert.strictEqual(handler1.callCount, 1, 'handler1 should be called once');
+            assert.strictEqual(handler2.callCount, 1, 'handler2 should be called once');
+        });
+
+        test('should remove a listener', () => {
+            setupEmitter();
+            const event = 'testEvent';
+            const handler = createMockFn();
+            emitter.on(event, handler);
+            emitter.off(event, handler);
+            emitter.emit(event);
+            assert.strictEqual(handler.callCount, 0, 'handler should not be called after removal');
+        });
+
+        test('should not emit if no listeners are registered', () => {
+            setupEmitter();
+            const event = 'testEvent';
+            const handler = createMockFn();
+            emitter.on(event, handler);
+            emitter.off(event, handler);
+            // Emit an event with no listeners
+            const result = emitter.emit('anotherEvent');
+            assert.strictEqual(handler.callCount, 0, 'handler should not be called for unknown event');
+            assert.strictEqual(result, false, 'emit should return false when no listeners are present'); // Expecting false if no listeners were there to be called
+        });
+
+        test('should return true if listeners were present and called', () => {
+            setupEmitter();
+            const event = 'testEvent';
+            const handler = createMockFn();
+            emitter.on(event, handler);
+            const result = emitter.emit(event);
+            assert.strictEqual(handler.callCount, 1, 'handler should be called');
+            assert.strictEqual(result, true, 'emit should return true when listeners are present and called');
+        });
+    });
+});
