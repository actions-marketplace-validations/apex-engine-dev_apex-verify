-    for (const fn of list) fn(...args);
-    return list.length > 0;
+    const handlersSnapshot = this.handlers[event] ? [...this.handlers[event]] : [];
+    let emittedSomething = false;
+
+    for (const entry of handlersSnapshot) {
+      // Ensure entry is valid and has a handler property
+      if (entry && typeof entry.handler === 'function') {
+        entry.handler(...args);
+        emittedSomething = true;
+
+        // 'once' handlers are removed by the wrapper calling `this.off`.
+        // If `this.off` correctly removes the handler from `this.handlers[event]`,
+        // then future `emit` calls will not see it.
+      }
+    }
+
+    // The original return value was based on the snapshot length. We'll keep that for consistency.
+    // If the snapshot had handlers, it means there were listeners registered at the time of emit.
+    return handlersSnapshot.length > 0;
   }
