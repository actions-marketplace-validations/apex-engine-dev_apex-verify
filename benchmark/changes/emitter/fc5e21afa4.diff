+    (this.handlers[event] ??= []).push({ handler: fn, isOnce: false, originalFn: null });
     return this;
   }
+
   once(event, fn) {
     const wrapper = (...args) => {
-      this.off(event, wrapper);
+      // Bug 1 Fix: Call original fn FIRST, then remove the listener.
       fn(...args);
