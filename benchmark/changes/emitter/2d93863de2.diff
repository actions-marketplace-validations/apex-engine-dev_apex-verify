diff -ruN -x node_modules -x .DS_Store -x .git a/test/fix.test.js b/test/fix.test.js
--- a/test/fix.test.js	1970-01-01 02:00:00
+++ b/test/fix.test.js	2026-11-20 14:42:18
@@ -0,0 +1,22 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { Emitter } from "../src/emitter.js";
+
+test("once listener firing does not skip next listener", () => {
+  const e = new Emitter();
+  let called = 0;
+  e.once('a', () => called++);
+  e.on('a', () => called++);
+  e.emit('a');
+  assert.equal(called, 2);
+});
+
+test("off removes once listener", () => {
+  const e = new Emitter();
+  let called = 0;
+  const fn = () => called++;
+  e.once('b', fn);
+  e.off('b', fn);
+  e.emit('b');
+  assert.equal(called, 0);
+});
