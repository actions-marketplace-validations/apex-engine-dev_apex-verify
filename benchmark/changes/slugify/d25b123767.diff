diff -ruN -x node_modules -x .DS_Store -x .git a/src/slug.js b/src/slug.js
--- a/src/slug.js	2026-11-19 21:42:44
+++ b/src/slug.js	2026-11-19 22:15:13
@@ -1,3 +1,9 @@
 export function slugify(text) {
-  return String(text).toLowerCase().trim().replace(/\s+/g, "-");
+  const lowercased = String(text).toLowerCase();
+  const normalized = lowercased.normalize('NFD').replace(/[̀-ͯ]/g, ''); // Remove accents
+  const alphanumeric = normalized.replace(/[^a-z0-9\s]/g, ''); // Remove non-alphanumeric, non-whitespace
+  const dashed = alphanumeric.replace(/\s+/g, '-'); // Replace whitespace with dashes
+  const cleaned = dashed.replace(/^-+|-+$/g, ''); // Trim leading/trailing dashes
+
+  return cleaned;
 }
