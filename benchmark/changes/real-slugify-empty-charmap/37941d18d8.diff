@@ -33,10 +33,27 @@
     var slug = string.normalize().split('')
       // replace characters based on charMap
       .reduce(function (result, ch) {
-        var appendChar = locale[ch] || charMap[ch] || ch;
-        if (appendChar === replacement) {
+        var localeChar = locale[ch];
+        var charMapChar = charMap[ch];
+        var appendChar;
+
+        // Determine the character to append, prioritizing locale, then charMap, else original char.
+        // We explicitly check for 'undefined' to allow empty string mappings ('') to be honored.
+        if (localeChar !== undefined) {
+            appendChar = localeChar;
+        } else if (charMapChar !== undefined) {
+            appendChar = charMapChar;
+        } else {
+            appendChar = ch;
+        }
+
+        // If a character maps to the replacement string (and isn't explicitly mapped to an empty string),
