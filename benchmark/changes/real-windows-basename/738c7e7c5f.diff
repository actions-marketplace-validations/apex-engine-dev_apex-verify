diff -ruN a/lib/picomatch.js b/lib/picomatch.js
--- a/lib/picomatch.js	2026-11-23 10:21:31
+++ b/lib/picomatch.js	2026-11-23 10:21:31
@@ -157,9 +157,16 @@
  * @api public
  */
 
-picomatch.matchBase = (input, glob, options) => {
+picomatch.matchBase = (input, glob, options, posix = false) => {
   const regex = glob instanceof RegExp ? glob : picomatch.makeRe(glob, options);
-  return regex.test(utils.basename(input));
+  // When `matchBase` is true, we need to ensure that the path separator
+  // rules are respected based on the `options.windows` setting.
+  // If `options.windows` is true, we need to use `\\` as the separator.
+  // Otherwise, we use `/`.
+  const separator = posix ? /[\\/]/ : '/';
+  const segments = input.split(separator);
+  const basename = segments[segments.length - 1];
+  return regex.test(basename);
 };
 
