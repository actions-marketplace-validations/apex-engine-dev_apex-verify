 exports.basename = (path, { windows } = {}) => {
-  const segs = path.split(windows ? /[\\/]/ : '/');
+  // When `windows` is true, we need to split by both backslash and forward slash.
+  // Otherwise, we only split by forward slash.
+  const separator = windows ? /[\\/]/ : '/';
+  const segs = path.split(separator);
   const last = segs[segs.length - 1];
 
   if (last === '') {
+    // If the last segment is empty, it means the path ends with a separator.
