 /**
  * RegExp to match non attr-char not handled by encodeURI.
+ *
+ * RFC 5987 `ext-value` allows `attr-char` and `pct-encoded`.
+ * `attr-char` = ALPHA / DIGIT / "!" / "#" / "$" / "&" / "+" / "-" / "." / "^" / "_" / "`" / "|" / "~"
+ *
+ * `encodeURI` does not encode: `A-Z a-z 0-9 ; , / ? : @ & = + $ - _ . ! ~ * ' ( ) #`
+ *
+ * Characters that `encodeURI` does not encode but are *not* `attr-char` (and thus must be percent-encoded):
+ * `( ) , / : ; = ? @ * '`
+ *
+ * The regex targets these characters to ensure they are percent-encoded by `pencode`.
  */
+var encodeUriAttrCharRegExp = /[*'()/:;=?@]/g
 
-var encodeUriAttrCharRegExp = /[*']/g
