diff -ruN -x node_modules -x .DS_Store -x .git a/test/bug-report-paginate.test.js b/test/bug-report-paginate.test.js
--- a/test/bug-report-paginate.test.js	1970-01-01 02:00:00
+++ b/test/bug-report-paginate.test.js	2026-11-20 08:03:19
@@ -0,0 +1,59 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { paginate } from "../src/paginate.js";
+
+// Tests that FAIL on the current code and will pass once fixed
+test("page 1 returns the first chunk of items (1-based indexing)", () => {
+  const r = paginate([1, 2, 3, 4], 1, 2);
+  assert.deepEqual(r.items, [1, 2]);
+});
+
+test("totalPages is correct when the last page is only partly full", () => {
+  const r = paginate([1, 2, 3, 4, 5], 1, 2);
+  assert.equal(r.totalPages, 3);
+});
+
+test("throws RangeError when size or page is less than 1", () => {
+  assert.throws(() => paginate([1, 2], 0, 2), RangeError);
+  assert.throws(() => paginate([1, 2], -1, 2), RangeError);
+  assert.throws(() => paginate([1, 2], 1, 0), RangeError);
+  assert.throws(() => paginate([1, 2], 1, -1), RangeError);
+});
+
+// Tests that pin nearby behavior that works today and must not change
+test("pins existing behavior: asking for a page past the end returns an empty page", () => {
+  const r = paginate([1, 2], 5, 2);
+  assert.deepEqual(r.items, []);
+  assert.equal(r.page, 5);
+});
+
+test("pins existing behavior: page property is returned exactly as passed", () => {
+  const r = paginate([1, 2, 3, 4], 2, 2);
+  assert.equal(r.page, 2);
+});
+
+// Edge cases
+test("edge case: repeating the operation many times keeps working the same way each time", () => {
+  for (let i = 0; i < 50; i++) {
+    const r = paginate([1, 2, 3, 4, 5], 2, 2);
+    assert.deepEqual(r.items, [3, 4]);
+    assert.equal(r.page, 2);
+    assert.equal(r.totalPages, 3);
+  }
+});
+
+test("edge case: works on empty input without throwing and returns the same result shape", () => {
+  const r = paginate([], 1, 2);
+  assert.deepEqual(r.items, []);
+  assert.equal(r.page, 1);
+  assert.equal(r.totalPages, 0);
+});
+
+test("edge case: the result keeps its type and format", () => {
+  const r = paginate([1, 2, 3], 1, 2);
+  assert.equal(typeof r, "object");
+  assert.notEqual(r, null);
+  assert.ok(Array.isArray(r.items));
+  assert.equal(typeof r.page, "number");
+  assert.equal(typeof r.totalPages, "number");
+});
