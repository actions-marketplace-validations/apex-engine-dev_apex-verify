diff -ruN -x node_modules -x .DS_Store -x .git a/test/bug-report-paginate.test.js b/test/bug-report-paginate.test.js
--- a/test/bug-report-paginate.test.js	1970-01-01 02:00:00
+++ b/test/bug-report-paginate.test.js	2026-11-20 07:50:00
@@ -0,0 +1,49 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { paginate } from "../src/paginate.js";
+
+test("page 1 returns the first chunk of items (1-based)", () => {
+  const r = paginate([1, 2, 3, 4, 5], 1, 2);
+  assert.deepEqual(r.items, [1, 2]);
+});
+
+test("totalPages is correct when the last page is partly full", () => {
+  const r = paginate([1, 2, 3, 4, 5], 1, 2);
+  assert.equal(r.totalPages, 3);
+});
+
+test("throws RangeError when size or page is less than 1", () => {
+  assert.throws(() => paginate([1, 2], 0, 2), RangeError);
+  assert.throws(() => paginate([1, 2], 1, 0), RangeError);
+});
+
+test("asking for a page past the end returns an empty page", () => {
+  const r = paginate([1, 2], 5, 2);
+  assert.deepEqual(r.items, []);
+});
+
+test("repeating the operation many times keeps working the same way each time", () => {
+  for (let i = 0; i < 50; i++) {
+    const r = paginate([1, 2, 3], 1, 2);
+    assert.ok(Array.isArray(r.items));
+    assert.equal(typeof r.page, "number");
+    assert.equal(typeof r.totalPages, "number");
+  }
+});
+
+test("works on empty input: no throw, and the same result shape", () => {
+  const r = paginate([], 1, 2);
+  assert.deepEqual(r.items, []);
+  assert.equal(r.page, 1);
+  assert.equal(r.totalPages, 0);
+});
+
+test("the result keeps its type and format", () => {
+  const r = paginate([1, 2, 3, 4], 1, 2);
+  assert.ok(Array.isArray(r.items));
+  assert.equal(typeof r.page, "number");
+  assert.equal(typeof r.totalPages, "number");
+  assert.ok("items" in r);
+  assert.ok("page" in r);
+  assert.ok("totalPages" in r);
+});
