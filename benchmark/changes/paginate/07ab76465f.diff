 export function paginate(items, page, size) {
-  const start = page * size;
+  if (size < 1 || page < 1) {
+    throw new RangeError("Page and size must be greater than or equal to 1.");
+  }
+  const start = (page - 1) * size;
+  const totalPages = Math.ceil(items.length / size);
   return {
