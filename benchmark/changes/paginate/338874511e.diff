diff -ruN -x node_modules -x .DS_Store -x .git a/src/paginate.js b/src/paginate.js
--- a/src/paginate.js	2026-11-19 21:42:44
+++ b/src/paginate.js	2026-11-21 04:11:29
@@ -1,8 +1,12 @@
-export function paginate(items, page, size) {
-  const start = page * size;
+export function paginate(items = [], page, size) {
+  if (page < 1 || size < 1) {
+    throw new RangeError("page and size must be at least 1");
+  }
+  const list = items || [];
+  const start = (page - 1) * size;
   return {
-    items: items.slice(start, start + size),
+    items: list.slice(start, start + size),
     page,
-    totalPages: Math.floor(items.length / size),
+    totalPages: Math.ceil(list.length / size),
   };
 }
diff -ruN -x node_modules -x .DS_Store -x .git a/test/visible.test.js b/test/visible.test.js
--- a/test/visible.test.js	2026-11-19 21:42:44
+++ b/test/visible.test.js	2026-11-21 04:13:00
@@ -1,8 +1,58 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
 import { paginate } from "../src/paginate.js";
+
 test("first page", () => {
   const r = paginate([1, 2, 3, 4, 5, 6], 1, 2);
   assert.deepEqual(r.items, [1, 2]);
   assert.equal(r.page, 1);
+  assert.equal(r.totalPages, 3);
 });
+
+test("second page", () => {
+  const r = paginate([1, 2, 3, 4, 5, 6], 2, 2);
+  assert.deepEqual(r.items, [3, 4]);
+  assert.equal(r.page, 2);
+  assert.equal(r.totalPages, 3);
+});
+
+test("partly full last page", () => {
+  const r = paginate([1, 2, 3, 4, 5], 3, 2);
+  assert.deepEqual(r.items, [5]);
+  assert.equal(r.page, 3);
+  assert.equal(r.totalPages, 3);
+});
+
+test("asking for a page past the end returns an empty page", () => {
+  const r = paginate([1, 2, 3, 4, 5], 4, 2);
+  assert.deepEqual(r.items, []);
+  assert.equal(r.page, 4);
+  assert.equal(r.totalPages, 3);
+
+  const rFar = paginate([1, 2, 3], 100, 2);
+  assert.deepEqual(rFar.items, []);
+  assert.equal(rFar.page, 100);
+  assert.equal(rFar.totalPages, 2);
+});
+
+test("empty items array returns 0 total pages and empty items", () => {
+  const r = paginate([], 1, 5);
+  assert.deepEqual(r.items, []);
+  assert.equal(r.page, 1);
+  assert.equal(r.totalPages, 0);
+});
+
+test("throws RangeError when size is less than 1", () => {
+  assert.throws(() => paginate([1, 2, 3], 1, 0), RangeError);
+  assert.throws(() => paginate([1, 2, 3], 1, -1), RangeError);
+});
+
+test("throws RangeError when page is less than 1", () => {
+  assert.throws(() => paginate([1, 2, 3], 0, 2), RangeError);
+  assert.throws(() => paginate([1, 2, 3], -1, 2), RangeError);
+});
+
+test("throws RangeError when both page and size are less than 1", () => {
+  assert.throws(() => paginate([1, 2, 3], 0, 0), RangeError);
+});
+
